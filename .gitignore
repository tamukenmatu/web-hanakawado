# ==========================================
# web-hanakawado - .gitignore
# ==========================================

# --- Dependencies & Package Managers ---
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# --- Next.js & Build Outputs ---
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# --- Cloudflare & Deployment Tools ---
.wrangler/
.vercel/

# --- Logs & Debug Outputs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Process & Runtime IDs (PID) ---
pids/
*.pid
*.pid.lock
*.pid.tmp
*.seed

# --- Python & Virtual Environments (venv) ---
venv/
.venv/
env/
ENV/
*.venv/
env.bak/
venv.bak/
__pycache__/
*.py[cod]
*$py.class

# --- Environment Variables (Credentials) ---
.env
.env*.local
.env.development
.env.test
.env.production
*.env
!.env.example

# --- Testing & Coverage ---
coverage/
.nyc_output/

# --- Temporary & Office Files ---
~$*
*.tmp
*.temp
*.xlsx
/ig/

# --- OS & System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- IDE & Editor Settings ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Security & Certificates ---
*.pem
*.key
*.cert
*.crt
